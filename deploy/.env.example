# CLI2API_IMAGE=ghcr.io/caigee-cmd/cli2api:latest
# QODER_WORKER_BASE_PORT=32100
# When 1/true, bare model IDs can route across Qoder and WorkBuddy accounts.
# Prefixed IDs (qoder/... / workbuddy/...) still pin one family.
# CROSS_PROVIDER_MODEL_POOL=0

# Optional GitHub token for release checks.
# UPDATE_GITHUB_TOKEN=
# macOS and Windows installers write the loopback updater endpoint and token here.
# UPDATE_AGENT_URL=
# UPDATE_AGENT_TOKEN=
# Linux socket directory, or a harmless Docker Desktop placeholder directory.
# CLI2API_UPDATER_SOCKET_DIR=/run/cli2api-updater
