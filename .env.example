HOST=127.0.0.1
PORT=3010
PROXY_API_KEY=change-me
# ALLOW_INSECURE_API_KEY=1

# SQLite account registry and per-account runtime homes.
QODER_DATA_DIR=/data
QODER_WORKER_BASE_PORT=32100
QODER_MAX_INFLIGHT=4

# Optional one-time import source for an existing Qoder login.
QODER_HOME=/root/.qoder

# Runtime paths are already set in the official image.
# QODER_NODE_BINARY=node
# QODER_WORKER_DAEMON=worker/src/daemon.mjs
# QODERCLI_JS=/usr/local/lib/node_modules/@qoder-ai/qodercli/bundle/qodercli.js
# PLAIN_TEMPLATE_PATH=worker/last-plain.sample.json
