HOST=127.0.0.1
PORT=3010
# SQLite account registry and durable account credentials.
QODER_DATA_DIR=/data
QODER_RUNTIME_DIR=/tmp/cli2api-runtime
QODER_WORKER_BASE_PORT=32100
# When 1/true, bare model IDs can route across Qoder and WorkBuddy accounts.
# CROSS_PROVIDER_MODEL_POOL=0

# Runtime paths are already set in the official image.
# QODER_NODE_BINARY=node
# QODER_WORKER_DAEMON=worker/src/daemon.mjs
# QODERCLI_JS=/usr/local/lib/node_modules/@qoder-ai/qodercli/bundle/qodercli.js
# PLAIN_TEMPLATE_PATH=worker/last-plain.sample.json

# Optional managed update integration.
# UPDATE_SOCKET_PATH=/run/cli2api-updater/updater.sock
# Docker Desktop on macOS/Windows:
# UPDATE_AGENT_URL=http://host.docker.internal:3011
# UPDATE_AGENT_TOKEN=
# UPDATE_GITHUB_TOKEN=

# Positive API-key lookup cache in milliseconds. 0 disables it; values above
# 300000 are clamped. Console key edits invalidate the cache immediately.
# CLI2API_AUTH_CACHE_MS=30000
# A streaming upstream that sends no bytes for this long is failed over.
# CLI2API_STREAM_IDLE_MS=300000
