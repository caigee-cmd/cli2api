HOST=127.0.0.1
PORT=3010
# SQLite account registry and durable account credentials.
QODER_DATA_DIR=/data
QODER_RUNTIME_DIR=/tmp/cli2api-runtime
QODER_WORKER_BASE_PORT=32100
QODER_MAX_INFLIGHT=4

