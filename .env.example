HOST=127.0.0.1
PORT=3010
PROXY_API_KEY=change-me
# ALLOW_INSECURE_API_KEY=1
QODER_HOME=/root/.qoder
# Optional: if Global PAT works, prefer this over encrypted OAuth blob.
# QODER_PERSONAL_ACCESS_TOKEN=

QODER_WORKER_URL=http://127.0.0.1:3020
QODER_WORKER_API_KEY=dev-key

# Optional multi-account: one HOME per Qoder login, comma-separated id=home
# Default compose: supervisor inside the single worker container.
# QODER_HOMES=acc1=/root,acc2=/home/acc2
# QODER_WORKER_URLS=http://qoder-auth-worker:3020
# QODER_ACCOUNT_IDS=acc1,acc2
# Optional: QODER_MAX_INFLIGHT=4
